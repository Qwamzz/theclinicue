# Copy to .env and adjust. Never commit the real .env (NFR-SEC-05).
# Every value below has a safe development default in app/config.py, except
# TC_SECRET_KEY, which the application refuses to start without in production.

# development | testing | production
TC_ENV=development

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production a missing key is a hard startup failure rather than a silently
# generated one, because a generated key would differ between workers and be
# discarded on every restart, logging everyone out.
TC_SECRET_KEY=

# Path to the SQLite file. On a container, point this at a mounted volume or
# the data is destroyed on every restart (technical debt TD-01).
TC_DATABASE_PATH=./data/theclinicue.sqlite3

# Send cookies only over HTTPS. Defaults to true when TC_ENV=production.
TC_COOKIE_SECURE=false

# Session lifetime in hours (NFR-SEC-03). Lower this to shrink the window in
# which a captured token stays valid — see technical debt TD-03.
TC_SESSION_HOURS=8

# Login throttle (FR-08): failures allowed per identity per window.
TC_LOGIN_MAX_ATTEMPTS=5
TC_LOGIN_WINDOW_SECONDS=900

# How far ahead patients may book, in days (FR-23).
TC_BOOKING_HORIZON_DAYS=60

# Seed demonstration data at start-up if the database has no users.
# Needed on Azure App Service, whose Oryx builder starts its own gunicorn and
# can ignore the custom startup command, leaving the catalogue empty.
# Safe to leave on: seeding is skipped whenever any user already exists.
TC_SEED_ON_START=false

# SQLite journal mode. WAL on local disk; DELETE on network storage such as
# Azure App Service's /home, where WAL is unreliable.
TC_SQLITE_JOURNAL=WAL

# Port for the development server and for gunicorn.
PORT=8000
