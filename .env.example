# Copy to .env and adjust. Never commit the real .env (NFR-SEC-05).
# Every value below has a safe development default in app/config.py, except
# CQ_SECRET_KEY, which the application refuses to start without in production.

# development | testing | production
CQ_ENV=development

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production a missing key is a hard startup failure rather than a silently
# generated one, because a generated key would differ between workers and be
# discarded on every restart, logging everyone out.
CQ_SECRET_KEY=

# Path to the SQLite file. On a container, point this at a mounted volume or
# the data is destroyed on every restart (technical debt TD-01).
CQ_DATABASE_PATH=./data/clinicue.sqlite3

# Send cookies only over HTTPS. Defaults to true when CQ_ENV=production.
CQ_COOKIE_SECURE=false

# Session lifetime in hours (NFR-SEC-03). Lower this to shrink the window in
# which a captured token stays valid — see technical debt TD-03.
CQ_SESSION_HOURS=8

# Login throttle (FR-08): failures allowed per identity per window.
CQ_LOGIN_MAX_ATTEMPTS=5
CQ_LOGIN_WINDOW_SECONDS=900

# How far ahead patients may book, in days (FR-23).
CQ_BOOKING_HORIZON_DAYS=60

# Port for the development server and for gunicorn.
PORT=8000
