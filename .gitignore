# Secrets — never commit (NFR-SEC-05)
.env
*.pem
*.key

# Database and runtime data
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Test and coverage artefacts
.pytest_cache/
.coverage
htmlcov/
test-results.xml

# Generated diagram previews (the .svg sources are committed)
docs/diagrams/_preview/
docs/diagrams/_contact_sheet.html

# Written at build time so /api/health can report the running commit
app/_build_info.json

# Build output
Submission/
*.zip

# Editor and IDE configuration — local to a machine, not part of the project
.vscode/
.idea/
.DS_Store
Thumbs.db
